POSTGRES_USER=workbench
POSTGRES_DB=workbench
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATABASE_URL=postgresql://workbench:URL_ENCODED_PASSWORD@db:5432/workbench
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PUBLIC_ORIGIN=https://tts.example.com
REGISTRATION_ENABLED=false
APP_HOST_PORT=8080
# Trust only the Docker gateway through which host Nginx reaches the container.
# Resolve the actual bridge address on the VPS; never set unrestricted true.
TRUST_PROXY=172.18.0.1/32
# Optional: no voice/key means honest empty catalogue and 503 synthesis.
# TTS_AZURE_SPEECH_KEY=
# TTS_AZURE_JA_VOICE_ID=
