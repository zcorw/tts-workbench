{
  "name": "@tts-workbench/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4181",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4182",
    "generate:api": "openapi-typescript ../../docs/openapi.yaml -o src/api/schema.d.ts",
    "test:contract": "node qa/react-check.cjs",
    "test:articles": "node qa/articles-check.cjs",
    "test:articles:integration": "node qa/articles-integration.cjs",
    "test:integration": "node qa/integration.cjs",
    "format:check": "prettier --check src vite.config.ts",
    "format": "prettier --write src vite.config.ts",
    "check:api": "node qa/contract-check.cjs",
    "test:password": "node qa/password-boundary-check.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@tanstack/react-query": "5.102.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-router-dom": "7.18.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "openapi-typescript": "7.13.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
